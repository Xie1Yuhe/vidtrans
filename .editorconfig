# 统一编辑风格，避免不同编辑器产生噪声 diff
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
# Windows 批处理必须是 CRLF，且只放 ASCII
end_of_line = crlf
charset = latin1

[*.sh]
end_of_line = lf
